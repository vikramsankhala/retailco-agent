{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python -m evals.run_evals:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python -m pytest -q -x 2>&1 | tail -5" }
        ]
      }
    ]
  }
}
